<div>
    {{#if isLoading}}
        <span class="fa fa-spinner fa-spin"></span>
    {{else}}
        <span class="fa fa-filter"
            data-tooltip="Download only the filtered data as csv"
            data-ga4-event="csv_filtered_download_click"
            data-download-type="text/csv">
        </span>
    {{/if}}
</div>
