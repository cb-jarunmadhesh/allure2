<div class="{{b 'widget' 'flex-line'}}">
    <div class="{{b 'widget' 'column'}}">
        <h2 class="{{b 'widget' 'title'}}">
            {{#if isAggregated}}
                {{t 'widget.summary.aggregatedName'}}
                <span class="{{b 'widget' 'subtitle'}}">{{launchesCount}} {{t 'widget.summary.launches' count=launchesCount}}</span>
            {{else}}
                {{reportName}} {{date time.stop}}
            {{/if}}
            <div class="{{b 'widget' 'subtitle'}}">
                {{time time.start}} - {{time time.stop}} ({{duration time.duration 2}})
            </div>
        </h2>
        <div class="{{b 'summary-widget' 'stats__container'}}">
            <a href="#suites" class="{{b 'stats-widget' 'stats'}} splash a">
                <div class="{{b 'summary-widget' 'stats'}} splash">
                    <div class="{{b 'splash' 'title'}}">{{statistic.total}}</div>
                    <div class="{{b 'splash' 'subtitle'}}">{{t 'widget.summary.testResults' count=statistic.total}}</div>
                </div>
            </a>
            <a href="#suites?broken=false&failed=false&skipped=false&unknown=false" class="{{b 'stats-widget' 'stats'}} splash a">
                <div class="{{b 'summary-widget' 'stats'}} splash">
                    <div class="{{b 'splash' 'title'}}">{{statistic.passed}}</div>
                    <div class="{{b 'splash' 'subtitle'}}">Passed</div>
                </div>
            </a>
            <a href="#suites?passed=false" class="{{b 'stats-widget' 'stats'}} splash a">
                <div class="{{b 'summary-widget' 'stats'}} splash">
                    <div class="{{b 'splash' 'title'}}">{{notPassed}}</div>
                    <div class="{{b 'splash' 'subtitle'}}">Failed</div>
                </div>
            </a>
        </div>
    </div>
    <div class="{{b 'widget' 'column'}} {{b 'summary-widget' 'chart'}}"></div>
</div>
